# ---- MyKep: приклад .env (скопіюйте у .env і заповніть) ----

# Токен бота, через якого працює "Login with Telegram" для /admin.
# У @BotFather: /setdomain -> mykep.pp.ua (або домен тестового сервера).
TELEGRAM_BOT_TOKEN=

# Старий статистичний бот вимкнено (його замінює /admin).
# disabled | embedded | external
BOT_MODE=disabled

# Адміни /admin. Жорсткий allowlist у config.py = 1125085502, 1320649428.
# Ця змінна може лише ЗВУЗИТИ список, додати сторонній ID нею неможливо.
# ADMIN_TELEGRAM_IDS=1125085502,1320649428

# Публічна адреса для перевірки Origin на POST-запитах адмінки.
# Вмикайте лише на продакшн-сервері, і рівно з тим доменом, де відкривається /admin.
# Якщо не задано, перевіряється збіг з Host запиту (підходить для тесту й localhost).
# ADMIN_PUBLIC_ORIGIN=https://mykep.pp.ua

# Сесії адмінки: абсолютний термін і тайм-аут неактивності (години).
ADMIN_SESSION_HOURS=168
ADMIN_IDLE_HOURS=72

# Розмір коледжу для метрики "охоплення".
ADMIN_COLLEGE_SIZE=1200

# ---- ЛИШЕ ДЛЯ ЛОКАЛЬНОЇ ПЕРЕВІРКИ (http://localhost) ----
# ADMIN_COOKIE_SECURE=0   # cookie без Secure, щоб працювало по http
# ADMIN_DEV_LOGIN=1       # вхід кнопкою без Telegram, тільки з 127.0.0.1 без проксі
#                         # (сервер ігнорує його, якщо ADMIN_COOKIE_SECURE не 0)
# НІКОЛИ не вмикайте ці два рядки на сервері!

# MYKEP_DB_PATH=schedule.db
# MYKEP_HOST=127.0.0.1
# MYKEP_PORT=8000
# PUBLIC_CSP=1
