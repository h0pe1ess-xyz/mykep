# Telegram Login identity, configured with /setdomain in BotFather
TELEGRAM_BOT_TOKEN=

# Optional restriction of the hard allowlist in config.py
# ADMIN_TELEGRAM_IDS=1125085502,1320649428

# Exact public origin, without a path or trailing slash
# ADMIN_PUBLIC_ORIGIN=https://mykep.pp.ua
ADMIN_COOKIE_SECURE=1
ADMIN_SESSION_HOURS=168
ADMIN_IDLE_HOURS=72
ADMIN_COLLEGE_SIZE=1200

# Use a separate database and ADMIN_COOKIE_SECURE=0 only for local HTTP testing
# MYKEP_DB_PATH=schedule.db
# MYKEP_HOST=127.0.0.1
# MYKEP_PORT=8000
# SCHEDULE_REFRESH_SECONDS=1800
# SCHEDULE_RETRY_SECONDS=30
# PUBLIC_CSP=1
