# Insert inside your EXISTING HTTPS server block, after adapting the host/port.
# This fragment does not configure DNS, certificates or an HTTP->HTTPS redirect.
# PWA requires HTTPS outside localhost.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_buffering on;
    # URL query strings contain anonymous client IDs. Avoid retaining them here.
    access_log off;
}
# Do not aggressively rate-limit by client IP: many students may share campus Wi-Fi.

# ---- MyKep Admin (/admin) — optional extra hardening ------------------------
# Put this in the `http {}` block (e.g. /etc/nginx/conf.d/mykep-limits.conf):
#   limit_req_zone $binary_remote_addr zone=mykep_admin_auth:10m rate=6r/m;
# And these locations next to `location /` in the same server block:
location /api/admin/auth/ {
    limit_req zone=mykep_admin_auth burst=5 nodelay;
    client_max_body_size 8k;
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
}
location /api/admin/ {
    client_max_body_size 8k;
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
}
